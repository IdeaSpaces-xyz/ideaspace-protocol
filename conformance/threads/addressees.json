{
  "format": "ideaspaces-thread-addressees/v1",
  "operation": "parse_post",
  "rule": "A post's optional to names who it asks: a string or a list of strings. Each entry is trimmed and must be nonempty, one line and at most 200 UTF-16 code units; repeats are dropped, authored order kept; at most 20 distinct. An absent field, an empty key or an empty list names no one. Any other value drops the field with warning invalid_to and the post stays valid. Addressees are claims compared exactly, never resolved, and grant, notify or restrict nothing.",
  "expected_fields": "status, to (absent when no one is named), kind when given, warnings (field and warning)",
  "vectors": [
    {
      "id": "one-addressee",
      "covers": [
        "to_single"
      ],
      "input": {
        "path": "_threads/t/2026-11-01T10-00-00-000Z-msg_ask.md",
        "content": "---\nid: msg_ask\nto: Integrator\n---\nCan you look?\n"
      },
      "expected": {
        "status": "valid",
        "warnings": [],
        "to": [
          "Integrator"
        ]
      }
    },
    {
      "id": "a-list-in-authored-order",
      "covers": [
        "to_list"
      ],
      "input": {
        "path": "_threads/t/2026-11-01T10-00-00-000Z-msg_ask.md",
        "content": "---\nid: msg_ask\nto:\n  - Security\n  - UI/UX\n---\nCan you look?\n"
      },
      "expected": {
        "status": "valid",
        "warnings": [],
        "to": [
          "Security",
          "UI/UX"
        ]
      }
    },
    {
      "id": "typed-addresses-are-kept-as-written",
      "covers": [
        "to_typed_address"
      ],
      "input": {
        "path": "_threads/t/2026-11-01T10-00-00-000Z-msg_ask.md",
        "content": "---\nid: msg_ask\nto:\n  - agent:repo:n_0935a5df1f883eeb60bcdfbb\n  - \"person:ernests\"\n---\nCan you look?\n"
      },
      "expected": {
        "status": "valid",
        "warnings": [],
        "to": [
          "agent:repo:n_0935a5df1f883eeb60bcdfbb",
          "person:ernests"
        ]
      }
    },
    {
      "id": "trimmed-and-repeats-dropped",
      "covers": [
        "to_normalized"
      ],
      "input": {
        "path": "_threads/t/2026-11-01T10-00-00-000Z-msg_ask.md",
        "content": "---\nid: msg_ask\nto:\n  - \" Scout \"\n  - Scout\n  - Backend\n---\nCan you look?\n"
      },
      "expected": {
        "status": "valid",
        "warnings": [],
        "to": [
          "Scout",
          "Backend"
        ]
      }
    },
    {
      "id": "any-kind-may-ask",
      "covers": [
        "to_any_kind"
      ],
      "input": {
        "path": "_threads/t/2026-11-01T10-00-00-000Z-msg_ask.md",
        "content": "---\nid: msg_ask\nkind: snapshot\nto: d-pm\n---\nCan you look?\n"
      },
      "expected": {
        "status": "valid",
        "warnings": [],
        "to": [
          "d-pm"
        ],
        "kind": "snapshot"
      }
    },
    {
