{
  "format": "ideaspaces-threads/v1",
  "thread_directory": "_threads",
  "required_coverage": [
    "post_frontmatter",
    "post_date_authored",
    "post_date_filename_fallback",
    "post_date_invalid",
    "post_date_day_only",
    "post_with_map",
    "quoted_colon_frontmatter",
    "out_of_order_timeline",
    "two_parent_join",
    "correction_supersedes",
    "closure_post",
    "home_map_member",
    "code_repo_separate_worktree_pin",
    "refuse_agent_and_assets_positions",
    "unaware_extension_skip"
  ],
  "vectors": [
    {
      "id": "parse-authored-date-preferred",
      "operation": "parse_post",
      "covers": ["post_date_authored"],
      "input": {
        "path": "2026-10-06T09-10-17-516Z-post.md",
        "content": "---\nid: msg_authored\ndate: 2026-10-06T09:12:17.516Z\n---\nAuthored time wins.\n"
      },
      "expected": {
        "status": "valid",
        "post": { "id": "msg_authored", "date": "2026-10-06T09:12:17.516Z", "kind": "post", "inReplyTo": [], "references": [] }
      }
    },
    {
      "id": "parse-legacy-filename-date",
      "operation": "parse_post",
      "covers": ["post_date_filename_fallback"],
      "input": {
        "path": "2026-10-06T09-10-17-516Z-post.md",
        "content": "---\nid: msg_legacy\n---\nLegacy time from name.\n"
      },
      "expected": {
        "status": "valid",
        "post": { "id": "msg_legacy", "date": "2026-10-06T09:10:17.516Z", "kind": "post", "inReplyTo": [], "references": [] }
      }
    },
    {
      "id": "parse-invalid-authored-date",
      "operation": "parse_post",
      "covers": ["post_date_invalid"],
      "input": { "path": "2026-02-28T09-10-17Z-post.md", "content": "---\nid: msg_bad\ndate: 2026-02-30T09:10:17Z\n---\nInvalid calendar day.\n" },
      "expected": { "status": "invalid", "issues": ["invalid_date"] }
    },
    {
      "id": "parse-day-only-legacy-date",
      "operation": "parse_post",
      "covers": ["post_date_day_only"],
      "input": { "path": "2026-09-26-01-decision.md", "content": "---\nid: msg_day\n---\nOld post.\n" },
      "expected": { "status": "valid", "post": { "id": "msg_day", "date": "2026-09-26T00:00:00.000Z", "kind": "post", "inReplyTo": [], "references": [] } }
    },
    {
      "id": "parse-unstamped-legacy-post",
      "operation": "parse_post",
      "covers": ["post_date_filename_fallback"],
      "input": { "path": "old-post.md", "content": "---\nid: msg_no_stamp\n---\nOld post.\n" },
      "expected": { "status": "valid", "post": { "id": "msg_no_stamp", "date": null, "kind": "post", "inReplyTo": [], "references": [] } }
    },
    {
      "id": "parse-basic-post",
      "operation": "parse_post",
      "covers": ["post_frontmatter"],
      "input": {
        "content": "---\nid: 2026-09-26T10:00:00Z-init\nkind: post\nname: Initial inquiry\nsummary: First post in the thread establishing requirements.\ntags:\n  - auth\n  - coordination\nactor_ref: person:user_34\nauthor: Alice\n---\n\nLet's agree on the authorization flow for local threads.\n"
      },
      "expected": {
        "status": "valid",
        "post": {
          "id": "2026-09-26T10:00:00Z-init",
          "kind": "post",
          "inReplyTo": [],
          "references": [],
          "body": "\nLet's agree on the authorization flow for local threads.\n"
        }
      }
    },
    {
      "id": "parse-quoted-colon-frontmatter",
      "operation": "parse_post",
      "covers": ["quoted_colon_frontmatter"],
      "input": {
        "content": "---\nid: 2026-09-26T10:30:00Z-colon\nin_reply_to: 2026-09-26T10:00:00Z-init\nreferences:\n  - 2026-09-26T10:00:00Z-init\nname: \"Decision: Authorization scope settled\"\nsummary: \"Key finding: root-relative positions work across boundaries\"\n---\n\nHere is the decision text.\n"
      },
      "expected": {
        "status": "valid",
        "post": {
          "id": "2026-09-26T10:30:00Z-colon",
          "kind": "post",
          "inReplyTo": ["2026-09-26T10:00:00Z-init"],
          "references": ["2026-09-26T10:00:00Z-init"],
          "body": "\nHere is the decision text.\n"
        }
      }
    },
    {
      "id": "parse-post-with-map",
      "operation": "parse_post",
      "covers": ["post_with_map"],
      "input": {
        "content": "---\nid: 2026-09-26T11:00:00Z-snapshot\nin_reply_to: 2026-09-26T10:30:00Z-colon\nreferences:\n  - 2026-09-26T10:00:00Z-init\n  - 2026-09-26T10:30:00Z-colon\nkind: snapshot\nname: State snapshot\nsummary: Snapshot carrying a Map selection\nmap:\n  roots:\n    - repo: https://ideaspaces.example/repos/n_0123456789abcdef01234567\n      sha: \"1111111111111111111111111111111111111111\"\n  members:\n    - root: 0\n      position: docs/auth.md\n      depth: surface\n---\n\nSnapshot of active authorization coordinates.\n"
      },
      "expected": {
        "status": "valid",
        "post": {
          "id": "2026-09-26T11:00:00Z-snapshot",
          "kind": "snapshot",
          "inReplyTo": ["2026-09-26T10:30:00Z-colon"],
          "references": ["2026-09-26T10:00:00Z-init", "2026-09-26T10:30:00Z-colon"],
          "body": "\nSnapshot of active authorization coordinates.\n"
        }
      }
    },
    {
      "id": "timeline-out-of-order-reconstruction",
      "operation": "reconstruct_timeline",
      "covers": ["out_of_order_timeline"],
      "input": {
        "posts": [
          {
            "id": "p3",
            "path": "_threads/auth/2026-09-26-03.md",
            "in_reply_to": "p2",
            "references": ["p1", "p2"],
            "kind": "post",
            "content": "---\nid: p3\nin_reply_to: p2\nreferences:\n  - p1\n  - p2\n---\nThird post\n"
          },
          {
            "id": "p1",
            "path": "_threads/auth/2026-09-26-01.md",
            "kind": "post",
            "content": "---\nid: p1\n---\nFirst post\n"
          },
          {
            "id": "p2",
            "path": "_threads/auth/2026-09-26-02.md",
            "in_reply_to": "p1",
            "references": ["p1"],
            "kind": "post",
            "content": "---\nid: p2\nin_reply_to: p1\nreferences:\n  - p1\n---\nSecond post\n"
          }
        ]
      },
      "expected": {
        "linearized_ids": ["p1", "p2", "p3"]
      }
    },
    {
      "id": "timeline-two-parent-join",
      "operation": "reconstruct_timeline",
      "covers": ["two_parent_join"],
      "input": {
        "posts": [
          {
            "id": "p_join",
            "path": "_threads/auth/2026-09-26-04-join.md",
            "in_reply_to": ["p_branch_a", "p_branch_b"],
            "references": ["p_init", "p_branch_a", "p_branch_b"],
            "kind": "post",
            "content": "---\nid: p_join\nin_reply_to:\n  - p_branch_a\n  - p_branch_b\nreferences:\n  - p_init\n  - p_branch_a\n  - p_branch_b\n---\nJoined decision\n"
          },
          {
            "id": "p_branch_b",
            "path": "_threads/auth/2026-09-26-03-branch-b.md",
            "in_reply_to": "p_init",
            "references": ["p_init"],
            "kind": "post",
            "content": "---\nid: p_branch_b\nin_reply_to: p_init\nreferences:\n  - p_init\n---\nBranch B proposal\n"
          },
          {
            "id": "p_branch_a",
            "path": "_threads/auth/2026-09-26-02-branch-a.md",
            "in_reply_to": "p_init",
            "references": ["p_init"],
            "kind": "post",
            "content": "---\nid: p_branch_a\nin_reply_to: p_init\nreferences:\n  - p_init\n---\nBranch A proposal\n"
          },
          {
            "id": "p_init",
            "path": "_threads/auth/2026-09-26-01-init.md",
            "kind": "post",
            "content": "---\nid: p_init\n---\nRoot topic\n"
          }
        ]
      },
      "expected": {
        "linearized_ids": ["p_init", "p_branch_a", "p_branch_b", "p_join"]
      }
    },
    {
      "id": "timeline-correction-and-closure",
      "operation": "reconstruct_timeline",
      "covers": ["correction_supersedes", "closure_post"],
      "input": {
        "posts": [
          {
            "id": "p_init",
            "path": "_threads/auth/01-init.md",
            "kind": "post",
            "content": "---\nid: p_init\n---\nInitial\n"
          },
          {
            "id": "p_flawed",
            "path": "_threads/auth/02-flawed.md",
            "in_reply_to": "p_init",
            "kind": "post",
            "content": "---\nid: p_flawed\nin_reply_to: p_init\n---\nFlawed assumption\n"
          },
          {
            "id": "p_corrected",
            "path": "_threads/auth/03-correction.md",
            "in_reply_to": "p_flawed",
            "kind": "correction",
            "supersedes": "p_flawed",
            "content": "---\nid: p_corrected\nin_reply_to: p_flawed\nkind: correction\nsupersedes: p_flawed\n---\nCorrected assumption\n"
          },
          {
            "id": "p_close",
            "path": "_threads/auth/04-close.md",
            "in_reply_to": "p_corrected",
            "kind": "closure",
            "content": "---\nid: p_close\nin_reply_to: p_corrected\nkind: closure\n---\nClosure\n"
          }
        ]
      },
      "expected": {
        "linearized_ids": ["p_init", "p_flawed", "p_corrected", "p_close"]
      }
    },
    {
