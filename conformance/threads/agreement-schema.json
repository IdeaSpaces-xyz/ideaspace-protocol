{
  "format": "ideaspaces-thread-agreement-schema/v1",
  "schema": "../../schema/thread-agreement.schema.json",
  "description": "Apply only to parsed leading YAML frontmatter of _threads/<thread>/_agent/agreement.md. No frontmatter block is an absent relation; broken YAML is diagnosed before JSON Schema. The legacy attached_to field is tolerated even when unusable as a parent edge. The Note schema remains separate.",
  "cases": [
    { "id": "absent-field", "frontmatter": { "name": "Child" }, "valid": true },
    { "id": "empty-frontmatter", "frontmatter": {}, "valid": true },
    { "id": "extension-field", "frontmatter": { "other": { "future": true } }, "valid": true },
    { "id": "id-parent", "frontmatter": { "attached_to": "msg_first" }, "valid": true, "parent": true },
    { "id": "path-parent", "frontmatter": { "attached_to": "_threads/parent/first.md" }, "valid": true, "parent": true },
    { "id": "typed-note-subject", "frontmatter": { "attached_to": "node:thing" }, "valid": true },
    { "id": "empty-id", "frontmatter": { "attached_to": "msg_" }, "valid": true },
    { "id": "readme-not-post", "frontmatter": { "attached_to": "_threads/parent/README.md" }, "valid": true },
    { "id": "hidden-thread", "frontmatter": { "attached_to": "_threads/.hidden/first.md" }, "valid": true },
    { "id": "traversal", "frontmatter": { "attached_to": "_threads/../first.md" }, "valid": true },
    { "id": "null-parent", "frontmatter": { "attached_to": null }, "valid": true },
    { "id": "array-parent", "frontmatter": { "attached_to": ["msg_first"] }, "valid": true }
  ],
  "note_schema_boundary": [
    { "frontmatter": { "attached_to": "node:thing" }, "valid": true },
    { "frontmatter": { "attached_to": "msg_first" }, "valid": false },
    { "frontmatter": { "attached_to": "_threads/parent/first.md" }, "valid": false }
  ]
}
