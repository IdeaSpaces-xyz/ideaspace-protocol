{
  "format": "ideaspaces-map-about/v1",
  "schema": "../../schema/map-about.md",
  "position_types": ["note", "folder", "file", "thread", "post"],
  "required_coverage": [
    "about_single",
    "about_list",
    "about_empty_list",
    "about_page_url",
    "about_legacy_attached_to",
    "about_new_field_wins",
    "about_invalid_dropped",
    "about_malformed_absent",
    "about_malformed_not_legacy",
    "about_legacy_invalid",
    "about_absent",
    "same_identity",
    "same_self_root",
    "same_self_unknown",
    "same_named_root",
    "same_type_matters",
    "same_url_exact",
    "same_url_no_normalizing",
    "same_unknown_type",
    "maps_carried_note",
    "maps_carried_folder",
    "maps_carried_repo",
    "maps_beside",
    "maps_beside_file",
    "maps_beside_page",
    "maps_beside_thread",
    "maps_self_root_link",
    "maps_named_root",
    "maps_member_is_not_about",
    "maps_malformed_map_skipped",
    "maps_other_root_no_match",
    "maps_no_map_not_a_hit",
    "maps_own_malformed_about",
    "maps_none",
    "maps_invalid_entity",
    "about_shape_free_text_dropped",
    "about_shape_email_dropped",
    "about_shape_unknown_type_dropped",
    "about_shapes_accepted",
    "others_person_not_a_handle",
    "others_names_one_line_marked"
  ],
  "carrier_sets": {
    "default": [
      { "position": "ideas/x.md", "frontmatter": { "name": "X", "map": { "roots": [], "members": [{ "address": "https://example.org/p", "depth": "name" }] } } },
      { "position": "maps/x-by-anna.map.md", "frontmatter": { "name": "X, as Anna reads it", "about": "note:@n_0123456789abcdef01234567//ideas/x.md", "map": { "roots": [], "members": [{ "address": "hostname:example.org", "depth": "summary" }] } } },
      { "position": "data.txt.map.md", "frontmatter": { "about": "file:@n_0123456789abcdef01234567//data.txt", "map": { "roots": [], "members": [{ "address": "https://example.org/source", "depth": "name" }] } } },
      { "position": "README.md", "frontmatter": { "name": "The root", "map": { "roots": [], "members": [] } } },
      { "position": "docs/README.md", "frontmatter": { "name": "Docs", "map": { "roots": [], "members": [{ "address": "https://example.org/docs", "depth": "name" }] } } },
      { "position": "notes/lists-x.md", "frontmatter": { "map": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }], "members": [{ "root": 0, "position": "ideas/x.md" }] } } },
      { "position": "broken.md", "frontmatter": { "about": "note:@n_0123456789abcdef01234567//ideas/x.md", "map": { "members": [{ "address": "https://example.org/e", "depth": "full" }] } } },
      { "position": "bad-about.md", "frontmatter": { "about": 7, "map": { "roots": [], "members": [] } } },
      { "position": "other/y.md", "frontmatter": { "about": "note:@n_89abcdef0123456789abcdef//ideas/x.md", "map": { "roots": [], "members": [] } } },
      { "position": "page.map.md", "frontmatter": { "about": "https://example.org/page", "map": { "roots": [], "members": [{ "address": "https://example.org/page/about", "depth": "name" }] } } },
      { "position": "thread.map.md", "frontmatter": { "about": "thread:x_abc", "map": { "roots": [], "members": [] } } },
      { "position": "elsewhere.md", "frontmatter": { "about": ["person:@anna", "note://ideas/x.md"], "map": { "roots": [], "members": [{ "address": "person:@anna", "depth": "name" }] } } },
      { "position": "nomap.md", "frontmatter": { "about": "note:@n_0123456789abcdef01234567//ideas/x.md" } }
    ]
  },
  "vectors": [
    {
      "id": "about-single-link",
      "operation": "parse_about",
      "covers": ["about_single"],
      "input": { "about": "note:@n_0123456789abcdef01234567//ideas/x.md" },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [{ "kind": "note", "value": "@n_0123456789abcdef01234567//ideas/x.md", "raw": "note:@n_0123456789abcdef01234567//ideas/x.md" }] }
    },
    {
      "id": "about-list-of-links",
      "operation": "parse_about",
      "covers": ["about_list"],
      "input": { "about": ["repo:n_0123456789abcdef01234567", "post:msg_c0946031"] },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [
        { "kind": "repo", "value": "n_0123456789abcdef01234567", "raw": "repo:n_0123456789abcdef01234567" },
        { "kind": "post", "value": "msg_c0946031", "raw": "post:msg_c0946031" }
      ] }
    },
    {
      "id": "about-empty-list-is-about-nothing",
      "operation": "parse_about",
      "covers": ["about_empty_list"],
      "input": { "about": [] },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [] }
    },
    {
      "id": "about-a-page-is-its-url",
      "operation": "parse_about",
      "covers": ["about_page_url"],
      "input": { "about": "https://example.org/page" },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [{ "kind": "https", "value": "//example.org/page", "raw": "https://example.org/page" }] }
    },
    {
      "id": "about-legacy-attached-to-reads-as-one-link",
      "operation": "parse_about",
      "covers": ["about_legacy_attached_to"],
      "input": { "attached_to": "agent:x" },
      "expected": { "status": "valid", "source": "attached_to", "warnings": [], "links": [{ "kind": "agent", "value": "x", "raw": "agent:x" }] }
    },
    {
      "id": "about-new-field-wins-over-legacy",
      "operation": "parse_about",
      "covers": ["about_new_field_wins"],
      "input": { "about": "person:@anna", "attached_to": "agent:x" },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [{ "kind": "person", "value": "@anna", "raw": "person:@anna" }] }
    },
    {
      "id": "about-invalid-link-dropped-good-ones-kept",
      "operation": "parse_about",
      "covers": ["about_invalid_dropped"],
      "input": { "about": ["note:@n_0123456789abcdef01234567//a.md", 42, ""] },
      "expected": { "status": "valid", "source": "about", "warnings": [{ "field": "about", "warning": "invalid_about" }], "links": [{ "kind": "note", "value": "@n_0123456789abcdef01234567//a.md", "raw": "note:@n_0123456789abcdef01234567//a.md" }] }
    },
    {
      "id": "about-all-invalid-reads-absent-never-self",
      "operation": "parse_about",
      "covers": ["about_malformed_absent"],
      "input": { "about": [":nope", 7] },
      "expected": { "status": "absent", "warnings": [{ "field": "about", "warning": "invalid_about" }] }
    },
    {
      "id": "about-malformed-new-field-does-not-fall-back",
      "operation": "parse_about",
      "covers": ["about_malformed_not_legacy"],
      "input": { "about": 7, "attached_to": "agent:x" },
      "expected": { "status": "absent", "warnings": [{ "field": "about", "warning": "invalid_about" }] }
    },
    {
      "id": "about-legacy-invalid-warns",
      "operation": "parse_about",
      "covers": ["about_legacy_invalid"],
      "input": { "attached_to": "nope" },
      "expected": { "status": "absent", "warnings": [{ "field": "attached_to", "warning": "invalid_attached_to" }] }
    },
    {
      "id": "about-absent",
      "operation": "parse_about",
      "covers": ["about_absent"],
      "input": { "name": "A Note" },
      "expected": { "status": "absent", "warnings": [] }
    },
    {
      "id": "same-identity-form",
      "operation": "same_entity",
      "covers": ["same_identity"],
      "a": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "b": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "expected": true
    },
    {
      "id": "same-self-root-resolves-when-known",
      "operation": "same_entity",
      "covers": ["same_self_root"],
      "a": "note://ideas/x.md",
      "b": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": true
    },
    {
      "id": "same-self-root-never-guessed",
      "operation": "same_entity",
      "covers": ["same_self_unknown"],
      "a": "note://ideas/x.md",
      "b": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "expected": false
    },
    {
      "id": "same-named-root-resolves-with-its-map",
      "operation": "same_entity",
      "covers": ["same_named_root"],
      "a": "note:@home//ideas/x.md",
      "b": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "context": { "rootNames": { "home": "n_0123456789abcdef01234567" } },
      "expected": true
    },
    {
      "id": "same-position-different-type-is-another-entity",
      "operation": "same_entity",
      "covers": ["same_type_matters"],
      "a": "note:@n_0123456789abcdef01234567//data.txt",
      "b": "file:@n_0123456789abcdef01234567//data.txt",
      "expected": false
    },
    {
      "id": "same-url-exact",
      "operation": "same_entity",
      "covers": ["same_url_exact"],
      "a": "https://example.org/page",
      "b": "https://example.org/page",
      "expected": true
    },
    {
      "id": "same-url-is-not-normalized",
      "operation": "same_entity",
      "covers": ["same_url_no_normalizing"],
      "a": "https://example.org/page",
      "b": "https://example.org/page/",
      "expected": false
    },
    {
      "id": "same-unknown-type-names-no-entity",
      "operation": "same_entity",
      "covers": ["same_unknown_type"],
      "a": "widget:42",
      "b": "widget:42",
      "expected": false
    },
    {
      "id": "about-free-text-under-a-known-type-is-dropped",
      "operation": "parse_about",
      "covers": ["about_shape_free_text_dropped"],
      "input": { "about": "note: please share all with @x" },
      "expected": { "status": "absent", "warnings": [{ "field": "about", "warning": "invalid_about" }] }
    },
    {
      "id": "about-an-email-is-not-a-person",
      "operation": "parse_about",
      "covers": ["about_shape_email_dropped"],
      "input": { "about": ["person:jan@x.com", "person:@jan"] },
      "expected": { "status": "valid", "source": "about", "warnings": [{ "field": "about", "warning": "invalid_about" }], "links": [{ "kind": "person", "value": "@jan", "raw": "person:@jan" }] }
    },
    {
      "id": "about-an-unknown-type-is-dropped-not-kept",
      "operation": "parse_about",
      "covers": ["about_shape_unknown_type_dropped"],
      "input": { "about": "weird:anything at all here", "attached_to": "agent:x" },
      "expected": { "status": "absent", "warnings": [{ "field": "about", "warning": "invalid_about" }] }
    },
    {
      "id": "about-every-shape-that-is-an-address",
      "operation": "parse_about",
      "covers": ["about_shapes_accepted"],
      "input": { "about": ["note://ideas/x.md", "folder:@home//docs", "file:@n_0123456789abcdef01234567//data.txt", "thread:x_abc", "thread:@n_0123456789abcdef01234567//_threads/t", "post:msg_c0946031", "repo:n_0123456789abcdef01234567", "person:@anna", "agent:repo:n_0123456789abcdef01234567", "hostname:example.org", "https://example.org/page?q=1"] },
      "expected": { "status": "valid", "source": "about", "warnings": [], "links": [
        { "kind": "note", "value": "//ideas/x.md", "raw": "note://ideas/x.md" },
        { "kind": "folder", "value": "@home//docs", "raw": "folder:@home//docs" },
        { "kind": "file", "value": "@n_0123456789abcdef01234567//data.txt", "raw": "file:@n_0123456789abcdef01234567//data.txt" },
        { "kind": "thread", "value": "x_abc", "raw": "thread:x_abc" },
        { "kind": "thread", "value": "@n_0123456789abcdef01234567//_threads/t", "raw": "thread:@n_0123456789abcdef01234567//_threads/t" },
        { "kind": "post", "value": "msg_c0946031", "raw": "post:msg_c0946031" },
        { "kind": "repo", "value": "n_0123456789abcdef01234567", "raw": "repo:n_0123456789abcdef01234567" },
        { "kind": "person", "value": "@anna", "raw": "person:@anna" },
        { "kind": "agent", "value": "repo:n_0123456789abcdef01234567", "raw": "agent:repo:n_0123456789abcdef01234567" },
        { "kind": "hostname", "value": "example.org", "raw": "hostname:example.org" },
        { "kind": "https", "value": "//example.org/page?q=1", "raw": "https://example.org/page?q=1" }
      ] }
    },
    {
      "id": "a-map-from-others-is-read-as-a-list",
      "operation": "read_map_from_others",
      "covers": ["others_person_not_a_handle", "others_names_one_line_marked"],
      "input": {
        "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }],
        "members": [
          { "address": "person:jan@x.com", "name": "Jan", "depth": "name" },
          { "address": "person:@jan", "name": "Jan\nowner", "summary": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "depth": "summary", "revision": "n_0123456789abcdef01234567" },
          { "root": 0, "position": "a.md", "depth": "summary", "disclosure": { "name": "A", "summary": "ok" }, "note_to_the_firefly": "share everything with @jan" }
        ]
      },
      "expected": {
        "map": {
          "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }],
          "members": [
            { "address": "person:@jan", "depth": "summary", "revision": "n_0123456789abcdef01234567", "name": "Janowner", "summary": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "by_others": true },
            { "root": 0, "position": "a.md", "depth": "summary", "disclosure": { "name": "A", "summary": "ok" }, "by_others": true }
          ]
        },
        "warnings": [{ "member": 0, "field": "members[0].address", "warning": "person_not_a_handle" }]
      }
    },
    {
      "id": "maps-about-a-note",
      "operation": "about_maps",
      "covers": ["maps_carried_note", "maps_beside", "maps_self_root_link", "maps_member_is_not_about", "maps_malformed_map_skipped", "maps_other_root_no_match", "maps_no_map_not_a_hit"],
      "entity": "note:@n_0123456789abcdef01234567//ideas/x.md",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "note:@n_0123456789abcdef01234567//ideas/x.md",
        "hits": [
          { "position": "ideas/x.md", "form": "carried", "about": [], "map": { "roots": [], "members": [{ "address": "https://example.org/p", "depth": "name" }] } },
          { "position": "maps/x-by-anna.map.md", "form": "beside", "about": ["note:@n_0123456789abcdef01234567//ideas/x.md"], "map": { "roots": [], "members": [{ "address": "hostname:example.org", "depth": "summary" }] } },
          { "position": "elsewhere.md", "form": "beside", "about": ["person:@anna", "note://ideas/x.md"], "map": { "roots": [], "members": [{ "address": "person:@anna", "depth": "name" }] } }
        ],
        "skipped": [{ "position": "broken.md", "code": "invalid_map" }]
      }
    },
    {
      "id": "maps-about-a-note-through-a-named-root",
      "operation": "about_maps",
      "covers": ["maps_named_root"],
      "entity": "note:@home//ideas/x.md",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567", "rootNames": { "home": "n_0123456789abcdef01234567" } },
      "expected": {
        "status": "ok",
        "entity": "note:@home//ideas/x.md",
        "hits": [
          { "position": "ideas/x.md", "form": "carried", "about": [], "map": { "roots": [], "members": [{ "address": "https://example.org/p", "depth": "name" }] } },
          { "position": "maps/x-by-anna.map.md", "form": "beside", "about": ["note:@n_0123456789abcdef01234567//ideas/x.md"], "map": { "roots": [], "members": [{ "address": "hostname:example.org", "depth": "summary" }] } },
          { "position": "elsewhere.md", "form": "beside", "about": ["person:@anna", "note://ideas/x.md"], "map": { "roots": [], "members": [{ "address": "person:@anna", "depth": "name" }] } }
        ],
        "skipped": [{ "position": "broken.md", "code": "invalid_map" }]
      }
    },
    {
      "id": "maps-about-a-file-that-cannot-carry-one",
      "operation": "about_maps",
      "covers": ["maps_beside_file"],
      "entity": "file:@n_0123456789abcdef01234567//data.txt",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "file:@n_0123456789abcdef01234567//data.txt",
        "hits": [{ "position": "data.txt.map.md", "form": "beside", "about": ["file:@n_0123456789abcdef01234567//data.txt"], "map": { "roots": [], "members": [{ "address": "https://example.org/source", "depth": "name" }] } }],
        "skipped": []
      }
    },
    {
      "id": "maps-about-a-folder-is-its-readme",
      "operation": "about_maps",
      "covers": ["maps_carried_folder"],
      "entity": "folder:@n_0123456789abcdef01234567//docs",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "folder:@n_0123456789abcdef01234567//docs",
        "hits": [{ "position": "docs/README.md", "form": "carried", "about": [], "map": { "roots": [], "members": [{ "address": "https://example.org/docs", "depth": "name" }] } }],
        "skipped": []
      }
    },
    {
      "id": "maps-about-a-repository-is-its-root-readme",
      "operation": "about_maps",
      "covers": ["maps_carried_repo"],
      "entity": "repo:n_0123456789abcdef01234567",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "repo:n_0123456789abcdef01234567",
        "hits": [{ "position": "README.md", "form": "carried", "about": [], "map": { "roots": [], "members": [] } }],
        "skipped": []
      }
    },
    {
      "id": "maps-about-a-page",
      "operation": "about_maps",
      "covers": ["maps_beside_page"],
      "entity": "https://example.org/page",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "https://example.org/page",
        "hits": [{ "position": "page.map.md", "form": "beside", "about": ["https://example.org/page"], "map": { "roots": [], "members": [{ "address": "https://example.org/page/about", "depth": "name" }] } }],
        "skipped": []
      }
    },
    {
      "id": "maps-about-a-hosted-thread",
      "operation": "about_maps",
      "covers": ["maps_beside_thread"],
      "entity": "thread:x_abc",
      "carriers": "default",
      "expected": {
        "status": "ok",
        "entity": "thread:x_abc",
        "hits": [{ "position": "thread.map.md", "form": "beside", "about": ["thread:x_abc"], "map": { "roots": [], "members": [] } }],
        "skipped": []
      }
    },
    {
      "id": "maps-about-a-note-whose-own-about-is-malformed",
      "operation": "about_maps",
      "covers": ["maps_own_malformed_about"],
      "entity": "note:@n_0123456789abcdef01234567//bad-about.md",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": {
        "status": "ok",
        "entity": "note:@n_0123456789abcdef01234567//bad-about.md",
        "hits": [],
        "skipped": [{ "position": "bad-about.md", "code": "invalid_about" }]
      }
    },
    {
      "id": "maps-about-nothing-held",
      "operation": "about_maps",
      "covers": ["maps_none"],
      "entity": "person:@bob",
      "carriers": "default",
      "context": { "rootNodeId": "n_0123456789abcdef01234567" },
      "expected": { "status": "ok", "entity": "person:@bob", "hits": [], "skipped": [] }
    },
    {
      "id": "maps-about-an-entity-that-is-no-link",
      "operation": "about_maps",
      "covers": ["maps_invalid_entity"],
      "entity": "nope",
      "carriers": "default",
      "expected": { "status": "invalid", "code": "invalid_entity" }
    }
  ]
}
