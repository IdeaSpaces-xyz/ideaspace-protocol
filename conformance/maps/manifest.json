      "expected": { "status": "valid", "map": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }, { "root_node_id": "n_111111111111111111111111", "sha": "2222222222222222222222222222222222222222" }], "members": [{ "root": 0, "position": "." }, { "root": 1, "position": "docs/decision.md", "depth": "surface" }] } }
