      "covers": ["space_unpinned"],
      "input": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }], "members": [{ "root": 0, "position": "README.md", "disclosure": { "name": "Home", "summary": "First level" } }] },
      "expected": { "status": "valid", "map": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }], "members": [{ "root": 0, "position": "README.md", "disclosure": { "name": "Home", "summary": "First level" } }] } }
    },
    {
