        { "map": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567" }], "members": [{ "root": 0, "position": ".", "depth": "summary" }] }, "pinned": false },
        { "map": { "roots": [{ "root_node_id": "n_0123456789abcdef01234567", "sha": "1111111111111111111111111111111111111111" }], "members": [{ "root": 0, "position": "." }] }, "pinned": false },
