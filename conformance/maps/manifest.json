{
  "format": "ideaspaces-maps/v3",
  "depths": ["name", "summary", "surface", "children", "full"],
  "subject_kinds": ["person", "team", "organisation", "agent", "public"],
  "capability_ladder": ["view", "read", "history", "copy", "write", "push", "manage"],
  "map_disclosure_capability": "view",
  "required_coverage": [
    "missing_allowed",
    "space_unpinned",
    "moment_pinned",
    "mixed_roots",
    "empty_progressive",
    "canonical_repo_url",
    "loopback_http",
    "reject_noncanonical_repo",
    "root_node_id_only",
    "both_root_identities",
    "root_identity_agreement",
    "exact_pin",
    "ordered_positions",
    "all_depths",
    "open_external_address",
    "external_depth_ceiling",
    "thread_address",
    "opaque_revision",
    "invalid_revision",
    "invalid_root_identity",
    "invalid_pin",
    "invalid_root_index",
    "invalid_position",
    "retired_space_field",
    "graceful_invalid_block",
    "emit",
    "observed_disclosure",
    "curator_separation",
    "unknown_type",
    "unknown_fields",
    "invalid_disclosure",
    "disclosure_ceiling",
    "access_vocabulary",
    "root_name",
    "invalid_root_name",
    "duplicate_root_name",
    "address_identity",
    "address_name",
    "address_self",
    "address_root_position",
    "address_round_trip",
    "address_extension_position",
    "address_invalid",
    "resolve_identity",
    "resolve_name",
    "resolve_default_name",
    "resolve_declared_name_wins",
    "resolve_self",
    "resolve_absent_root",
    "resolve_ambiguous"
  ],
  "vectors": [
    {
      "id": "space-map-unpinned-root-and-shallow-member",
