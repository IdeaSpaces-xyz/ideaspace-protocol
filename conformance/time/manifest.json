{
  "format": "ideaspaces-time/v1",
  "schema": "../../schema/time.md",
  "state_vectors": "state.json",
  "memory_vectors": "memory.json",
  "threads_vectors": {
    "manifest": "../threads/manifest.json",
    "files": ["metalayer.json", "parent.json", "current-map.json"],
    "operations": ["parse_post", "reconstruct_timeline", "inspect_posts", "current_thread_map"],
    "rule": "Every vector of these operations in the Thread files passes unchanged through the time operations under their Thread names (parse_entry, reconstruct_timeline, inspect_entries, current_map), and passes again on a folder that is not _threads/: every path value whose first two segments are _threads/<thread>/ is rewritten to <declared_folder>/ (in input paths, opening paths, expected post and skipped paths, unreadable paths, warning post names and the write refusal text), the folder is declared as keeping time by its Agreement, and the expected result is otherwise unchanged. Tree-resolution vectors (resolve_parent) belong to the Threads kind and are not rewritten.",
    "declared_folder": "notes",
    "covers": ["threads_vectors_pass", "threads_vectors_pass_declared"]
  },
  "required_coverage": [
    "threads_vectors_pass",
    "threads_vectors_pass_declared",
    "state_newest_readable_wins",
    "closed_field",
    "closed_reopens",
    "closed_legacy_closure",
    "closed_field_over_legacy_kind",
    "closed_invalid_dropped",
    "closed_unknown_newer_unreadable",
    "closed_older_unreadable_settled",
    "snapshot_any_entry_with_map",
    "reframe_sets_name_summary",
    "reframe_move_without_name",
    "thread_name_falls_back_to_opening",
    "declared_folder_no_name_fallback",
    "correction_supersedes_entry",
    "only_correction_supersedes",
    "as_of_by_entry",
    "as_of_by_moment",
    "as_of_day_cursor",
    "as_of_unresolved",
    "as_of_state",
    "since_by_entry",
    "since_by_moment",
    "since_day_only_entry",
    "newest_n",
    "newest_invalid",
    "undated_named",
    "ambiguous_id_cursor",
    "window_as_of_and_since",
    "keeps_time_declared",
    "keeps_time_invalid",
    "notes_outside_timeline",
    "declared_id_must_be_string",
    "memory_add",
    "memory_supersede",
    "memory_as_of",
    "memory_since",
    "current_map_skips_notes",
    "moved_to_set",
    "moved_to_refuses_writes",
    "moved_to_invalid_dropped",
    "moved_to_newest_readable_wins"
  ]
}
