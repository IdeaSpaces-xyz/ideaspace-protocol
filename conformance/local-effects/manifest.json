    {
      "id": "write-stale-worktree-refusal",
      "covers": ["revision_stale_worktree"],
      "initial": {
        "head": { "note.md": { "content": "v1" } },
        "index": { "note.md": { "content": "v1" } },
        "worktree": { "note.md": { "content": "v1" } },
        "ignore": []
      },
      "before_request": [{ "action": "write_worktree", "path": "note.md", "content": "v2" }],
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "replacement\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "revision_mismatch", "phase": "revision_check", "affected_paths": [] },
        "facts": { "paths": { "note.md": { "worktree": "v2", "index": "v1", "head": "v1" } }, "unchanged": [] }
      }
    },
    {
      "id": "write-stale-index-refusal",
      "covers": ["revision_stale_index"],
      "initial": {
        "head": { "note.md": { "content": "v1" } },
        "index": { "note.md": { "content": "v1" } },
        "worktree": { "note.md": { "content": "v1" } },
        "ignore": []
      },
      "before_request": [
        { "action": "write_worktree", "path": "note.md", "content": "v2" },
        { "action": "stage", "paths": ["note.md"] },
        { "action": "write_worktree", "path": "note.md", "content": "v1" }
      ],
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "replacement\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "revision_mismatch", "phase": "revision_check", "affected_paths": [] },
