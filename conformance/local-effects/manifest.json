      }
    },
    {
      "id": "write-stale-head-refusal",
      "covers": ["revision_stale_head"],
      "initial": {
        "head": { "note.md": { "content": "v1" } },
        "index": { "note.md": { "content": "v1" } },
        "worktree": { "note.md": { "content": "v1" } },
        "ignore": []
      },
      "before_request": [
        { "action": "write_worktree", "path": "note.md", "content": "v2" },
        { "action": "stage", "paths": ["note.md"] },
        { "action": "commit", "paths": ["note.md"], "message": "Concurrent change" },
        { "action": "write_worktree", "path": "note.md", "content": "v1" },
        { "action": "stage", "paths": ["note.md"] }
      ],
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "replacement\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "revision_mismatch", "phase": "revision_check", "affected_paths": [] },
        "facts": { "paths": { "note.md": { "worktree": "v1", "index": "v1", "head": "v2" } }, "unchanged": [] }
      }
    },
    {
      "id": "write-stage-failure-is-partial",
      "covers": ["write_stage_partial"],
      "initial": { "head": {}, "index": {}, "worktree": {}, "ignore": [] },
      "fault": { "phase": "stage", "when": "before" },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
        "frontmatter": { "mode": "replace", "set": { "name": "New" }, "remove": [] },
        "body": "# New\n",
        "stage": true
      },
      "expected": {
        "result": {
          "status": "partial",
          "code": "stage_failed",
          "phase": "stage",
          "completed_phases": ["revision_check", "write"],
          "affected_paths": ["note.md"]
        },
        "facts": {
          "paths": {
            "note.md": { "frontmatter": { "name": "New" }, "body_exact": "# New\n", "index": null, "head": null }
          },
          "unchanged": []
        }
      }
    },
    {
