{
  "format": "ideaspaces-local-effects/v1",
  "contents": {
    "empty": "",
    "v1": "v1\n",
    "v2": "v2\n",
    "v3": "v3\n",
    "new-note": "# New\n",
    "unicode-old": "---\nname: Old\n---\n# Old\n",
    "frontmatter-rich": "---\nname: Old\nunknown_scalar: keep\nunknown_list:\n  - one\n  - two\nunknown_map:\n  nested: true\nobsolete: remove me\n---\n# Old body\n",
    "frontmatter-malformed": "---\nname: [broken\n---\n# Old\n",
    "frontmatter-duplicate": "---\nname: One\nname: Two\n---\n# Old\n",
    "frontmatter-list": "---\n- not\n- a map\n---\n# Old\n",
    "outside": "outside\n"
  },
  "required_coverage": [
    "unicode_create",
    "unicode_update",
    "absolute_path_refusal",
    "traversal_refusal",
    "reserved_git_refusal",
    "literal_pathspec",
    "target_symlink_refusal",
    "ancestor_symlink_refusal",
    "ignored_new_refusal",
    "tracked_ignored_commit",
    "frontmatter_preserve_unknown",
    "frontmatter_remove",
    "frontmatter_malformed_refusal",
    "frontmatter_duplicate_refusal",
    "frontmatter_non_map_refusal",
    "frontmatter_replace_repair",
    "revision_absent",
    "revision_matching",
    "revision_stale_worktree",
    "revision_stale_index",
    "revision_stale_head",
    "write_stage_partial",
    "bystanders_preserved",
    "commit_create",
    "commit_modify",
    "commit_plain_delete",
    "commit_staged_delete",
    "commit_rename",
    "commit_mixed_paths",
    "selected_changed_before_commit",
    "invalid_multi_path_refuses_all",
    "commit_failure_partial",
    "valid_trailers",
    "invalid_trailers",
    "conflicting_trailers",
    "explicit_identity_no_ambient"
  ],
  "vectors": [
    {
      "id": "write-unicode-create",
      "covers": ["unicode_create", "revision_absent"],
      "initial": { "head": {}, "index": {}, "worktree": {}, "ignore": [] },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "notes with spaces/日本語.md",
        "expected_revision": { "$revision": "reviewed", "path": "notes with spaces/日本語.md" },
        "frontmatter": { "mode": "preserve", "set": { "name": "日本語" }, "remove": [] },
        "body": "# New\n",
        "stage": true
      },
      "expected": {
        "result": { "status": "ok", "affected_paths": ["notes with spaces/日本語.md"] },
        "facts": {
          "paths": {
            "notes with spaces/日本語.md": {
              "frontmatter": { "name": "日本語" },
              "body_exact": "# New\n",
              "index_matches_worktree": true,
              "head": null
            }
          },
          "unchanged": []
        }
      }
    },
    {
      "id": "write-unicode-update-preserves-frontmatter",
      "covers": ["unicode_update", "revision_matching", "frontmatter_preserve_unknown", "frontmatter_remove"],
      "initial": {
        "head": { "notes with spaces/日本語.md": { "content": "frontmatter-rich" } },
        "index": { "notes with spaces/日本語.md": { "content": "frontmatter-rich" } },
        "worktree": { "notes with spaces/日本語.md": { "content": "frontmatter-rich" } },
        "ignore": []
      },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "notes with spaces/日本語.md",
        "expected_revision": { "$revision": "reviewed", "path": "notes with spaces/日本語.md" },
        "frontmatter": {
          "mode": "preserve",
          "set": { "name": "New" },
          "remove": ["obsolete"]
        },
        "body": "# Updated\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "ok", "affected_paths": ["notes with spaces/日本語.md"] },
        "facts": {
          "paths": {
            "notes with spaces/日本語.md": {
              "frontmatter": {
                "name": "New",
                "unknown_scalar": "keep",
                "unknown_list": ["one", "two"],
                "unknown_map": { "nested": true }
              },
              "frontmatter_absent": ["obsolete"],
              "body_exact": "# Updated\n",
              "index": "frontmatter-rich",
              "head": "frontmatter-rich"
            }
          },
          "unchanged": []
        }
      }
    },
    {
      "id": "write-path-boundary-refusals",
      "covers": ["absolute_path_refusal", "traversal_refusal", "reserved_git_refusal"],
      "cases": [
        { "path": "/outside.md", "code": "path_escape" },
        { "path": "../outside.md", "code": "path_escape" },
        { "path": "notes/../../outside.md", "code": "path_escape" },
        { "path": ".git/config.md", "code": "reserved_git_path" }
      ],
      "initial": { "head": {}, "index": {}, "worktree": {}, "ignore": [] },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "$CASE.path",
        "expected_revision": "any",
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "outside\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "$CASE.code", "phase": "preflight", "affected_paths": [] },
        "facts": { "paths": {}, "unchanged": [] }
      }
    },
    {
      "id": "commit-literal-pathspec",
      "covers": ["literal_pathspec"],
      "initial": {
        "head": { "x.md": { "content": "v1" } },
        "index": { "x.md": { "content": "v1" } },
        "worktree": { "x.md": { "content": "v1" }, "[x].md": { "content": "v2" } },
        "ignore": []
      },
      "request": {
        "operation": "commit_paths",
        "root": "$ROOT",
        "paths": [{ "path": "[x].md", "expected_revision": { "$revision": "reviewed", "path": "[x].md" } }],
        "message": "Commit literal path",
        "trailers": { "op": "create" },
        "author": { "name": "Person", "email": "person@example.com" },
        "committer": { "name": "Person", "email": "person@example.com" }
      },
      "expected": {
        "result": { "status": "ok", "affected_paths": ["[x].md"], "commit_paths": ["[x].md"] },
        "facts": { "paths": { "[x].md": { "worktree": "v2", "index": "v2", "head": "v2" } }, "unchanged": ["x.md"] }
      }
    },
    {
      "id": "write-target-symlink-refusal",
      "covers": ["target_symlink_refusal"],
      "initial": {
        "head": {},
        "index": {},
        "worktree": {
          "outside.md": { "content": "outside" },
          "notes/link.md": { "symlink": "../outside.md" }
        },
        "ignore": []
      },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "notes/link.md",
        "expected_revision": "any",
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "changed\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "symlink_refused", "phase": "preflight", "affected_paths": [] },
        "facts": { "paths": {}, "unchanged": ["outside.md", "notes/link.md"] }
      }
    },
    {
      "id": "write-ancestor-symlink-refusal",
      "covers": ["ancestor_symlink_refusal"],
      "initial": {
        "head": {},
        "index": {},
        "worktree": {
          "real/a.md": { "content": "v1" },
          "linked": { "symlink": "real" }
        },
        "ignore": []
      },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "linked/a.md",
        "expected_revision": "any",
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "changed\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "symlink_refused", "phase": "preflight", "affected_paths": [] },
        "facts": { "paths": {}, "unchanged": ["real/a.md", "linked"] }
      }
    },
    {
      "id": "write-ignored-new-refusal",
      "covers": ["ignored_new_refusal"],
      "initial": { "head": {}, "index": {}, "worktree": {}, "ignore": ["drafts/**"] },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "drafts/private.md",
        "expected_revision": { "$revision": "reviewed", "path": "drafts/private.md" },
        "frontmatter": { "mode": "replace", "set": {}, "remove": [] },
        "body": "private\n",
        "stage": true
      },
      "expected": {
        "result": { "status": "error", "code": "ignored_local_path", "phase": "preflight", "affected_paths": [] },
        "facts": { "paths": { "drafts/private.md": { "worktree": null, "index": null, "head": null } }, "unchanged": [] }
      }
    },
    {
      "id": "write-malformed-frontmatter-refusals",
      "covers": ["frontmatter_malformed_refusal", "frontmatter_duplicate_refusal", "frontmatter_non_map_refusal"],
      "cases": [
        { "content": "frontmatter-malformed" },
        { "content": "frontmatter-duplicate" },
        { "content": "frontmatter-list" }
      ],
      "initial": {
        "head": { "note.md": { "content": "$CASE.content" } },
        "index": { "note.md": { "content": "$CASE.content" } },
        "worktree": { "note.md": { "content": "$CASE.content" } },
        "ignore": []
      },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
        "frontmatter": { "mode": "preserve", "set": { "name": "Repaired" }, "remove": [] },
        "body": "# New\n",
        "stage": false
      },
      "expected": {
        "result": { "status": "error", "code": "malformed_frontmatter", "phase": "preflight", "affected_paths": [] },
        "facts": { "paths": { "note.md": { "worktree": "$CASE.content", "index": "$CASE.content", "head": "$CASE.content" } }, "unchanged": [] }
      }
    },
    {
      "id": "write-replace-repairs-malformed-frontmatter",
      "covers": ["frontmatter_replace_repair"],
      "initial": {
        "head": { "note.md": { "content": "frontmatter-malformed" } },
        "index": { "note.md": { "content": "frontmatter-malformed" } },
        "worktree": { "note.md": { "content": "frontmatter-malformed" } },
        "ignore": []
      },
      "request": {
        "operation": "write_markdown",
        "root": "$ROOT",
        "path": "note.md",
        "expected_revision": { "$revision": "reviewed", "path": "note.md" },
