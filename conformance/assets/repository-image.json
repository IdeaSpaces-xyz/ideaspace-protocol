{
  "format": "ideaspaces-repository-image/v1",
  "field": "image",
  "source": "README.md",
  "max_bytes": 262144,
  "media_types": {
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "webp": "image/webp"
  },
  "notes": "Tree entries: {text} is UTF-8, {base64} is bytes, {fill:{prefix_base64,size}} is the prefix padded with zero bytes to size, {symlink} is a relative symlink; an entry's optional `mode` (octal) is applied after writing. A vector marked `unprivileged` needs a reader that permissions apply to: a runner as root skips it. `tree` is the repository root; `beside` is the folder that holds the repository root, for targets outside it. A problem's `message` is implementation text and is not compared.",
  "required_coverage": [
    "declaration_valid",
    "declaration_absent",
    "declaration_not_a_string",
    "declaration_invalid_reference",
    "declaration_outside_root",
    "declaration_not_in_assets",
    "declaration_unsupported_type",
    "read_valid",
    "read_no_readme",
    "read_no_field",
    "read_root_readme_only",
    "read_missing",
    "read_symlink_loop",
    "read_not_a_file",
    "read_symlink_outside_root",
    "read_symlink_inside_root",
    "read_too_large",
    "read_size_boundary",
    "read_type_mismatch",
    "read_svg_unsupported",
    "read_unreadable",
    "look_root_image",
    "look_problem_not_fatal"
  ],
  "vectors": [
    {
      "id": "declaration-valid",
      "operation": "declaration",
