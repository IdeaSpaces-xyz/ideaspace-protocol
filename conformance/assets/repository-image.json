{
  "format": "ideaspaces-repository-image/v1",
  "field": "image",
  "source": "README.md",
  "max_bytes": 262144,
  "media_types": {
    "png": "image/png",
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "webp": "image/webp",
    "svg": "image/svg+xml"
  },
  "notes": "Tree entries: {text} is UTF-8, {base64} is bytes, {fill:{prefix_base64,size}} is the prefix padded with zero bytes to size, {symlink} is a relative symlink. `tree` is the Space root; `beside` is the folder that holds the Space root, for targets outside it. A problem's `message` is implementation text and is not compared.",
  "required_coverage": [
    "declaration_valid",
    "declaration_absent",
    "declaration_not_a_string",
    "declaration_invalid_reference",
    "declaration_outside_root",
    "declaration_not_in_assets",
    "declaration_unsupported_type",
    "read_valid",
    "read_no_readme",
    "read_no_field",
    "read_root_readme_only",
    "read_missing",
    "read_not_a_file",
    "read_symlink_outside_root",
    "read_symlink_inside_root",
    "read_too_large",
    "read_size_boundary",
    "read_type_mismatch",
    "read_unsafe_svg",
    "svg_accepted",
    "svg_not_svg",
    "svg_refused",
    "look_root_image",
    "look_problem_not_fatal"
  ],
  "vectors": [
    {
      "id": "declaration-valid",
      "operation": "declaration",
      "covers": [
        "declaration_valid"
      ],
      "cases": [
        {
          "value": "_assets/avatar.png",
          "expected": {
            "status": "declared",
            "path": "_assets/avatar.png",
            "media_type": "image/png"
          }
        },
        {
          "value": "./_assets/icon.SVG",
          "expected": {
            "status": "declared",
            "path": "_assets/icon.SVG",
            "media_type": "image/svg+xml"
          }
        },
        {
          "value": "_assets/people/portrait.jpeg",
          "expected": {
            "status": "declared",
            "path": "_assets/people/portrait.jpeg",
            "media_type": "image/jpeg"
          }
        },
        {
          "value": "_assets/a.jpg",
          "expected": {
            "status": "declared",
            "path": "_assets/a.jpg",
            "media_type": "image/jpeg"
          }
        },
        {
          "value": "_assets/a.webp",
          "expected": {
            "status": "declared",
            "path": "_assets/a.webp",
            "media_type": "image/webp"
          }
        },
        {
          "value": "notes/_assets/a.png",
          "expected": {
            "status": "declared",
            "path": "notes/_assets/a.png",
            "media_type": "image/png"
          }
        }
      ]
    },
