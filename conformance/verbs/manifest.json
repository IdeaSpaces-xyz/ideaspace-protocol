    {
      "id": "post-share-from-the-persons-words",
      "operation": "validate_request",
      "covers": ["post_share_valid_from_person"],
      "context": { "caller": "agent", "person_asked": ["share"], "person_named": ["repo:n_9ffe8bb354f1b10b6fbb059e", "@b", "explore"], "reach": ["repo:n_9ffe8bb354f1b10b6fbb059e"] },
      "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b", "grade": "explore" },
      "expected": { "status": "valid", "verb": "post", "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b", "grade": "explore" } }
    },
    {
      "id": "post-share-target-the-person-never-named",
      "operation": "validate_request",
      "covers": ["post_share_target_not_from_person"],
      "context": { "caller": "agent", "person_asked": ["share"], "person_named": ["@b", "explore"], "reach": ["repo:n_9ffe8bb354f1b10b6fbb059e"] },
      "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b", "grade": "explore" },
      "expected": { "status": "refused", "reason_code": "not_from_person", "field": "target", "next": null }
    },
    {
      "id": "post-share-with-a-handle-read-in-a-note",
      "operation": "validate_request",
      "covers": ["post_share_with_not_from_person"],
      "context": { "caller": "agent", "person_asked": ["share"], "person_named": ["repo:n_9ffe8bb354f1b10b6fbb059e", "explore"], "reach": ["repo:n_9ffe8bb354f1b10b6fbb059e"] },
      "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@x", "grade": "explore" },
      "expected": { "status": "refused", "reason_code": "not_from_person", "field": "with", "next": null }
    },
    {
      "id": "post-share-with-nothing-the-person-said-known",
      "operation": "validate_request",
      "covers": ["post_share_nothing_known_fails_closed"],
      "cases": [
        { "context": { "caller": "agent" }, "expected": { "status": "refused", "reason_code": "not_from_person", "field": "request", "next": null } },
        { "context": { "caller": "agent", "person_asked": ["share"] }, "expected": { "status": "refused", "reason_code": "not_from_person", "field": "target", "next": null } }
      ],
      "context": "$CASE.context",
      "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b", "grade": "explore" }
    },
    {
      "id": "post-share-at-a-grade-the-person-never-named",
