      "cases": [
        { "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b", "grade": "admin" }, "expected": { "status": "refused", "reason_code": "not_from_person", "field": "grade", "next": null } },
        { "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b" }, "expected": { "status": "valid", "verb": "post", "request": { "verb": "post", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "request": "share", "with": "@b" } } }
      ],
      "request": "$CASE.request"
    },
    {
      "id": "post-publish-the-person-did-not-ask-for",
      "operation": "validate_request",
      "covers": ["post_publish_not_asked"],
      "context": { "caller": "agent", "person_asked": ["share"], "person_named": ["/s/garden", "@b"] },
      "request": { "verb": "post", "target": "/s/garden", "request": "publish" },
      "expected": { "status": "refused", "reason_code": "not_from_person", "field": "request", "next": null }
    },
    {
