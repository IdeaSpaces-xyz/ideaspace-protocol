{
  "format": "ideaspaces-verbs/v1",
  "schema": "../../schema/verbs.md",
  "verbs": ["map", "look", "post", "write"],
  "namespace": "ideaspaces",
  "routes": {
    "cli": "ideaspaces <verb>",
    "mcp": "mcp__ideaspaces__<verb>",
    "flat": "ideaspaces_<verb>"
  },
  "post_requests": ["entry", "start_thread", "share", "revoke", "visibility", "publish"],
  "map_requests": ["read", "create", "add", "remove"],
  "fact_fields": [
    "outcome", "path", "saved", "history", "shared", "change", "post", "item", "with", "from", "level",
    "public", "pin", "now", "until", "look", "map", "page", "warnings", "reason_code", "next"
  ],
  "reason_codes": [
    "unknown_verb", "retired_name", "missing_field", "unexpected_field", "invalid_field", "unknown_request",
    "out_of_reach", "local_only", "keeps_time", "changed_since_read", "no_identity", "not_from_person",
    "person_only", "limit_reached", "redirected"
  ],
  "words_note": "The said sentences are AX's, from the table in schema/verbs.md (The words), with Plan, @bea and Viewer standing in for {name}, {who} and {level}. said_forbidden_words is AX's list; every check_answer vector that checks words uses it. The vectors check shape and the list, not the wording of each sentence.",
  "said_forbidden_words": [
    "git", "commit", "commits", "committed", "committing", "uncommitted",
    "push", "pushes", "pushed", "pushing", "unpushed",
    "pull", "pulls", "pulled", "pulling", "fetch", "fetched",
    "merge", "merged", "merging", "rebase", "rebased",
    "branch", "branches", "checkout", "clone", "cloned", "stash", "diff",
    "staged", "staging", "unstaged", "untracked", "worktree", "HEAD",
    "repository", "repositories", "repo", "repos", "remote", "remotes", "upstream",
    "sha", "hash",
    "Vault", "Vaults"
  ],
  "required_coverage": [
    "verb_spelling_per_route",
    "alias_resolves_to_verb",
    "retired_name_refused_with_next",
    "unknown_verb_refused",
    "map_read_default",
    "map_add_takes_a_file",
    "map_unknown_request_refused",
    "map_remote_out_of_reach",
    "look_local_valid",
    "look_remote_in_reach",
    "look_invalid_depth",
    "post_entry_default_valid",
    "post_entry_correction_needs_supersedes",
    "post_unknown_request_refused",
    "post_unexpected_field_refused",
    "post_share_valid_from_person",
    "post_share_target_not_from_person",
    "post_share_with_not_from_person",
    "post_share_nothing_known_fails_closed",
    "post_share_grade_not_from_person",
    "post_publish_not_asked",
    "post_public_not_asked",
    "post_revoke_by_person",
    "post_revoke_by_agent_person_only",
    "post_revoke_by_agent_before_fields",
    "post_revoke_by_person_from_card",
    "look_remote_no_reach_known",
    "post_hosted_entry_no_reach_known",
    "post_visibility_boolean",
    "post_publish_local_folder",
    "post_publish_service_address_refused",
    "post_start_thread_nobody_needs_nothing_asked",
    "post_start_thread_with_from_person",
    "write_body_valid",
    "write_edits_valid",
    "write_history_only",
    "write_body_and_edits_exclusive",
    "write_over_entry_keeps_time",
    "write_service_address_local_only",
    "write_frontmatter_markdown_only",
    "answer_ok_valid",
    "answer_said_first",
    "answer_said_forbidden_word",
    "answer_said_hash",
    "answer_said_git_command",
    "answer_unknown_fact",
    "answer_credential_has_no_slot",
    "answer_credential_in_said",
    "answer_credential_in_warning",
    "answer_credential_in_next",
    "answer_credential_as_field_name",
    "answer_short_change",
    "answer_refused_needs_reason_and_next",
    "answer_next_is_verb_call",
    "answer_next_git_command",
    "answer_next_null_allowed",
    "answer_partial_needs_reason",
    "answer_render_order"
  ],
  "vectors": [
    {
      "id": "spelling-per-route",
      "operation": "spell_verb",
      "covers": ["verb_spelling_per_route"],
      "cases": [
        { "route": "cli", "verb": "look", "expected": "ideaspaces look" },
        { "route": "mcp", "verb": "look", "expected": "mcp__ideaspaces__look" },
        { "route": "flat", "verb": "look", "expected": "ideaspaces_look" },
        { "route": "mcp", "verb": "write", "expected": "mcp__ideaspaces__write" },
        { "route": "flat", "verb": "post", "expected": "ideaspaces_post" }
      ]
    },
    {
      "id": "alias-threads-post-is-post",
      "operation": "validate_request",
      "covers": ["alias_resolves_to_verb"],
      "context": { "aliases": { "threads_post": "post" } },
      "request": { "verb": "threads_post", "target": "_threads/2026-11-17-plan", "body": "Claimed." },
      "expected": { "status": "valid", "verb": "post", "request": { "verb": "post", "target": "_threads/2026-11-17-plan", "body": "Claimed.", "request": "entry" } }
    },
    {
      "id": "retired-note-write-names-write",
      "operation": "validate_request",
      "covers": ["retired_name_refused_with_next"],
      "context": { "retired": { "note_write": "write" } },
      "request": { "verb": "note_write", "target": "notes/a.md", "body": "# A\n" },
      "expected": { "status": "refused", "reason_code": "retired_name", "field": "verb", "next": { "verb": "write" } }
    },
    {
      "id": "unknown-verb",
      "operation": "validate_request",
      "covers": ["unknown_verb_refused"],
      "request": { "verb": "sync", "target": "." },
      "expected": { "status": "refused", "reason_code": "unknown_verb", "field": "verb", "next": null }
    },
    {
      "id": "map-read-is-the-default",
      "operation": "validate_request",
      "covers": ["map_read_default"],
      "request": { "verb": "map", "start": "notes/", "depth": "summary" },
      "expected": { "status": "valid", "verb": "map", "request": { "verb": "map", "start": "notes/", "depth": "summary", "request": "read" } }
    },
    {
      "id": "map-add-a-file-to-a-space",
      "operation": "validate_request",
      "covers": ["map_add_takes_a_file"],
      "request": { "verb": "map", "start": "home.map.md", "request": "add", "member": "/Users/someone/Documents/plan.pdf" },
      "expected": { "status": "valid", "verb": "map", "request": { "verb": "map", "start": "home.map.md", "request": "add", "member": "/Users/someone/Documents/plan.pdf" } }
    },
    {
      "id": "map-unknown-request",
      "operation": "validate_request",
      "covers": ["map_unknown_request_refused"],
      "request": { "verb": "map", "start": "notes/", "request": "sync" },
      "expected": { "status": "refused", "reason_code": "unknown_request", "field": "request", "next": null }
    },
    {
      "id": "map-remote-out-of-reach",
      "operation": "validate_request",
      "covers": ["map_remote_out_of_reach"],
      "context": { "reach": ["thread:x_0123456789abcdef01234567"] },
      "request": { "verb": "map", "start": "repo:n_9ffe8bb354f1b10b6fbb059e" },
      "expected": { "status": "refused", "reason_code": "out_of_reach", "field": "start", "next": null }
    },
    {
      "id": "look-a-local-note",
      "operation": "validate_request",
      "covers": ["look_local_valid"],
      "request": { "verb": "look", "target": "notes/a.md", "depth": "surface" },
      "expected": { "status": "valid", "verb": "look", "request": { "verb": "look", "target": "notes/a.md", "depth": "surface" } }
    },
    {
      "id": "look-a-hosted-thread-in-reach",
      "operation": "validate_request",
      "covers": ["look_remote_in_reach"],
      "context": { "reach": ["thread:x_0123456789abcdef01234567"] },
      "request": { "verb": "look", "target": "thread:x_0123456789abcdef01234567", "depth": "children", "limit": 10 },
      "expected": { "status": "valid", "verb": "look", "request": { "verb": "look", "target": "thread:x_0123456789abcdef01234567", "depth": "children", "limit": 10 } }
    },
    {
      "id": "look-remote-with-no-reach-known",
      "operation": "validate_request",
      "covers": ["look_remote_no_reach_known"],
      "request": { "verb": "look", "target": "repo:n_9ffe8bb354f1b10b6fbb059e", "depth": "summary" },
      "expected": { "status": "refused", "reason_code": "out_of_reach", "field": "target", "next": null }
    },
    {
      "id": "post-hosted-entry-with-no-reach-known",
      "operation": "validate_request",
      "covers": ["post_hosted_entry_no_reach_known"],
      "request": { "verb": "post", "target": "thread:x_0123456789abcdef01234567", "body": "A reply.", "reply_to": "msg_0f3a9c2e-5b7d-4e81-9a6c-2d4f8b1e7c35" },
      "expected": { "status": "refused", "reason_code": "out_of_reach", "field": "target", "next": null }
    },
    {
      "id": "look-invalid-depth",
      "operation": "validate_request",
      "covers": ["look_invalid_depth"],
      "request": { "verb": "look", "target": "notes/a.md", "depth": "outline" },
      "expected": { "status": "refused", "reason_code": "invalid_field", "field": "depth", "next": { "verb": "look" } }
    },
    {
      "id": "post-an-entry-by-default",
      "operation": "validate_request",
      "covers": ["post_entry_default_valid"],
      "request": { "verb": "post", "target": "_threads/2026-11-17-plan", "body": "PR 110 is open.", "reply_to": "msg_0f3a9c2e-5b7d-4e81-9a6c-2d4f8b1e7c35", "author": "Integrator" },
      "expected": { "status": "valid", "verb": "post", "request": { "verb": "post", "target": "_threads/2026-11-17-plan", "body": "PR 110 is open.", "reply_to": "msg_0f3a9c2e-5b7d-4e81-9a6c-2d4f8b1e7c35", "author": "Integrator", "request": "entry" } }
    },
    {
      "id": "post-correction-needs-supersedes",
      "operation": "validate_request",
      "covers": ["post_entry_correction_needs_supersedes"],
      "request": { "verb": "post", "target": "memory", "body": "The tag resolves in the lock.", "kind": "correction" },
      "expected": { "status": "refused", "reason_code": "missing_field", "field": "supersedes", "next": { "verb": "post", "request": "entry", "kind": "correction" } }
    },
    {
      "id": "post-unknown-request",
      "operation": "validate_request",
      "covers": ["post_unknown_request_refused"],
      "context": { "caller": "person", "person_named": ["notes/", "@b"] },
      "request": { "verb": "post", "target": "notes/", "request": "invite", "with": "@b" },
      "expected": { "status": "refused", "reason_code": "unknown_request", "field": "request", "next": null }
    },
    {
      "id": "post-share-with-a-field-that-is-not-its-kinds",
      "operation": "validate_request",
      "covers": ["post_unexpected_field_refused"],
      "context": { "caller": "agent", "person_named": ["notes/plan.md", "@b"] },
      "request": { "verb": "post", "target": "notes/plan.md", "request": "share", "with": "@b", "grade": "explore", "history": true },
      "expected": { "status": "refused", "reason_code": "unexpected_field", "field": "history", "next": { "verb": "post" } }
