{
  "name": "@ideaspaces/protocol",
  "version": "0.13.4",
  "description": "The open standard for how agents turn useful work into durable, portable knowledge",
  "keywords": [
    "ideaspaces",
    "agents",
    "knowledge",
    "markdown",
    "git",
    "local-first",
    "protocol",
    "conformance"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js"
    },
    "./local-effects": {
      "types": "./dist/local-effects-runtime.d.ts",
      "import": "./dist/local-effects-runtime.js"
    },
    "./schema/frontmatter": "./schema/frontmatter.schema.json",
    "./schema/repository-path": "./schema/repository-path.md",
    "./schema/extensions": "./schema/extensions.md",
    "./schema/assets": "./schema/assets.md",
    "./schema/local-effects": "./schema/local-effects.md",
    "./schema/root-identity": "./schema/root-identity.md",
    "./schema/maps": "./schema/maps.md",
    "./conformance/extensions": "./conformance/extensions/manifest.json",
    "./conformance/assets": "./conformance/assets/manifest.json",
    "./conformance/local-effects": "./conformance/local-effects/manifest.json",
    "./conformance/root-identity": "./conformance/root-identity/manifest.json",
    "./conformance/maps": "./conformance/maps/manifest.json",
    "./SPEC.md": "./SPEC.md",
    "./SKILLS.md": "./SKILLS.md",
    "./templates/foundation-core.md": "./templates/foundation-core.md"
  },
  "files": [
    "dist",
    "conformance/extensions",
    "conformance/assets",
    "conformance/local-effects",
    "conformance/root-identity",
    "conformance/maps",
    "skills",
    "templates",
    "SPEC.md",
    "SKILLS.md",
    "schema",
    "VERSION"
  ],
  "scripts": {
    "prepare": "npm run build",
    "embed-skills": "node scripts/embed-skills.mjs",
    "build": "npm run clean && npm run embed-skills && tsc",
    "check:package": "node scripts/check-package.mjs",
    "dev": "npm run embed-skills && tsc --watch",
    "pretest": "npm run embed-skills",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IdeaSpaces-xyz/ideaspace-protocol.git"
  },
  "homepage": "https://ideaspaces.xyz/developers#protocol",
  "bugs": {
    "url": "https://github.com/IdeaSpaces-xyz/ideaspace-protocol/issues"
  },
  "sideEffects": false
}
